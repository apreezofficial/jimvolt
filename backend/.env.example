# PostgreSQL. For Aiven use the service (or connection-pool) host, port, user and database,
# and set DB_SSL_CA to the downloaded CA certificate (required for any non-local host).
DB_HOST=localhost
DB_USER=jimvolt_user
DB_PASSWORD=replace-with-the-application-user-password
DB_NAME=jimvolt_db
DB_PORT=5432
# DB_SSL_CA=certs/ca.pem
# DB_SSL_MODE=require   # encrypt without verifying the certificate (prefer DB_SSL_CA)
#
# Supabase on Vercel (transaction pooler):
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_PORT=6543
#   DB_USER=jimvolt_app.<project-ref>
#   DB_NAME=postgres
#   DB_SSL_CA=certs/supabase-ca.crt
# Connections per instance (2 on Vercel, 10 elsewhere by default).
# DB_CONNECTION_LIMIT=2
JWT_SECRET=
PORT=5000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=
EMAIL_FROM=Jimvolt <no-reply@yourdomain.com>

# Supabase Storage for private seller verification documents.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key

# Google sign-in. Authorised redirect URI in Google Cloud: <PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google popup sign-in (frontend build variable, same client ID as GOOGLE_CLIENT_ID).
# Add the site origin to the client's Authorised JavaScript origins in Google Cloud.
VITE_GOOGLE_CLIENT_ID=

# Contact page form, submitted to Voieform (https://voieform.com). Frontend build variable.
# Use the public form key from your Voieform dashboard (it only accepts submissions).
VITE_VOIEFORM_FORM_KEY=

# ---- Paystack (promotion payments) ----
# test = sandbox, live = real money. Keys come from Paystack Dashboard > Settings > API Keys & Webhooks.
PAYSTACK_MODE=test
# Test secret key (starts with sk_test_)
PAYSTACK_TEST_SECRET_KEY=
# Live secret key (starts with sk_live_)
PAYSTACK_LIVE_SECRET_KEY=
# Webhook URL to set in the Paystack dashboard: https://api.jimvolt.com/api/payments/webhook
# Callback URL after payment is built from FRONTEND_URL (/dashboard/promotions).
